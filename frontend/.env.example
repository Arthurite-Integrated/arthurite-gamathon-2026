# Copy to .env.local, or generate it from the deployed stack:
#   cd ../backend && npm run env:frontend
# On Amplify these are set automatically by the CDK frontend stack.

VITE_PROJECT_NAME=starter
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Realtime rooms WebSocket (stack output WebSocketUrl). Leave out if enableRealtime is false.
VITE_WS_URL=wss://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
