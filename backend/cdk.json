{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "package*.json", "node_modules", "test", "cdk.out"]
  },
  "context": {
    "projectName": "starter",
    "region": "us-east-1",
    "removeDataOnDestroy": true,
    "corsAllowedOrigins": ["*"],
    "githubOwner": "",
    "githubRepo": "",
    "githubBranch": "main",
    "githubTokenSecretName": "github-token",
    "enableRealtime": true,
    "realtimeGraceSeconds": 30,
    "realtimeRateLimitPerSec": 30,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true
  }
}
